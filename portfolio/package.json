{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "node scripts/patch-vercel-og.mjs",
    "emulators": "firebase emulators:start --only auth,firestore,storage --project portfoliosite-b12da",
    "dev:emulators": "cross-env NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true concurrently -k -n emulators,next -c yellow,cyan \"npm:emulators\" \"next dev\"",
    "content": "tsx scripts/content.ts",
    "usage": "tsx scripts/usage.ts",
    "test:e2e": "playwright test",
    "test:e2e:edge": "cross-env PW_CHANNEL=msedge playwright test"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^13.10.0",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": "22"
  }
}
