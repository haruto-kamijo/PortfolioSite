{
  "hosting": {
    "public": "hosting-redirect",
    "ignore": [
      "**/.*"
    ],
    "redirects": [
      {
        "regex": "^/(?P<path>.*)$",
        "destination": "https://kamijoharuto.com/:path",
        "type": 301
      }
    ]
  },
  "apphosting": [
    {
      "backendId": "portfolio",
      "rootDir": "/",
      "ignore": [
        "node_modules",
        ".git",
        "**/.env*",
        ".next",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "test-results",
        "playwright-report",
        "hosting-redirect",
        "tsconfig.tsbuildinfo"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "storage": { "port": 9199 },
    "ui": { "enabled": true, "port": 4000 },
    "singleProjectMode": true
  }
}
