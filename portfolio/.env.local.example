# Firebase クライアント設定
# Firebase コンソール → プロジェクトの設定 → マイアプリ（ウェブ）からコピーする。
# NEXT_PUBLIC_ 付きの値はブラウザに露出するが、これは公開前提の識別子なので問題ない。
# 実際の保護は firestore.rules / storage.rules で行う。
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=portfoliosite-b12da.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=portfoliosite-b12da
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=portfoliosite-b12da.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ローカルでエミュレータを使うとき true にする（本番では設定しない）
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false

# サーバー側(Admin SDK)。Cloud Run 上では既定のサービスアカウントが自動で使われるため不要。
# ローカルでエミュレータを使わず本番Firestoreに繋ぐ場合のみサービスアカウントJSONのパスを指定する。
# GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=portfoliosite-b12da

# 問い合わせ通知：メール（Resend）
# resend.com でドメイン kamijoharuto.com を認証し、送信専用APIキーを発行して設定する
RESEND_API_KEY=
CONTACT_NOTIFY_TO=kamijoharuto@gmail.com
CONTACT_NOTIFY_FROM=contact@kamijoharuto.com

# 問い合わせ通知：チャット（任意・未設定ならスキップされる）
# discord または slack の Incoming Webhook URL
CONTACT_CHAT_WEBHOOK_URL=
CONTACT_CHAT_WEBHOOK_KIND=discord

# 管理画面に入れるメールアドレス（カンマ区切り）
# firestore.rules / storage.rules の isAdmin() のリストと必ず揃える
ADMIN_EMAILS=kamijoharuto@gmail.com
